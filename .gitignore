# Dependencies and caches
node_modules/
.cache/
__pycache__/
*.py[cod]
*.tsbuildinfo

# Render output and delivery packages (keep local files)
/out/
/deliverables/

# Final handout PDFs and raster images stay local; keep selection JSON in Git
/docs/lessons/ch*/L*/handout/**/*.pdf
/docs/lessons/ch*/L*/handout/**/*.png
/docs/lessons/ch*/L*/handout/**/*.jpg
/docs/lessons/ch*/L*/handout/**/*.jpeg
/docs/lessons/ch*/L*/handout/**/*.webp

# Temporary output (handout source files now live in scripts/ and docs/)
/tmp/

# Keep audio and historical voice backups local; Git stores code and lesson data
/public/audio/
/workspaces/**/*.wav
/workspaces/ch06-L01-quiz/before-voice-fix/

# Local configuration and logs
.env
.env.*
!.env.example
!.env.sample
*.log
.DS_Store
Thumbs.db

# Keep public/fonts/ (including licenses) and test01 workspace JSON in Git.
# Restore local audio backups before voiced playback or rendering on a new machine.

# 课程私有目录默认不提交。演示课 test01 的源码和工作区 JSON 除外。
/src/lessons/*
!/src/lessons/test01/
!/src/lessons/test01/**
/docs/lessons/*
!/docs/lessons/test01/
!/docs/lessons/test01/**
/workspaces/*
/workspaces/test01/**
!/workspaces/test01/
!/workspaces/test01/**/
!/workspaces/test01/**/*.json
/workspaces/current-lesson.json
/scripts/ch06-*
/scripts/ch08-*
/scripts/render-ch06-*
/scripts/build-l0*
/scripts/gen-l0*
/scripts/rebuild-l01-*
/scripts/restore-l01-*
/scripts/run-l01-audio.ts
/scripts/film-to-lesson.ts
/scripts/_lesson-arg.ts
/src/visual/prototypes/L02Lab.tsx
/src/visual/prototypes/L03Preview.tsx
/src/visual/prototypes/l01-generated.ts
/src/visual/compositions.tsx
