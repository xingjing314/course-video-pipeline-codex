    {
      "sceneId": "E-boundary",
      "narration": "很多学员在面对组织过程资产 OPA 和事业环境因素 EEF 时总是记混。其实它们有一条根本的哲学分界线：那就是项目团队能否自主修改和裁剪它？",
      "narrationSha256": "17db184d40fee0d440191adab14365dec8f3fa3622379745247250c252fda639",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-codex/workspaces/ch06-L01-environment/audio/E-boundary.wav",
