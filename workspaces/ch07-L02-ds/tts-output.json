  "fullWavSha256": "218256d9b395e1d50f0bce5b5eef842951eebd7cd0c4fa209f032f60da77c494",
  "ttsEngine": "Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign",
  "device": "cuda",
  "scenes": [
    {
      "sceneId": "S01",
      "narration": "上一节我们讲到，建设单位把《项目建议书》交给上级主管部门，领导批复说：“这个方向不错，去深入论证一下吧！”这时候，项目就正式迈进了 7.2 项目可行性研究。",
      "narrationSha256": "2d6a1511b43607bc5739f4254fb6fdb90f948612f462a485078b1d1438b2fc91",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S01.wav",
      "wavSha256": "7729581e06354fdee4c414eba51dd01f3c8412f9700c70525cdcc37e6a5c29ab",
      "startMs": 0,
      "endMs": 15563,
      "durationMs": 15563,
      "fromCache": false
    },
    {
      "sceneId": "S02",
      "narration": "什么叫可行性研究？就是在项目建议书被批准之后，从技术、经济、社会和人员等方面的条件进行调查研究，对可能的技术方案进行论证，最终确定整个项目到底可不可行。",
      "narrationSha256": "e15eb0b1511d345e16292cdf877638ff8773d7a54bc8b23b2c1a454a5ea0d8b3",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S02.wav",
      "wavSha256": "2383d5cbcc8905835b91f0f9b0bcb0ac4a02193c569b7a9b6d7fd1fd8211331b",
      "startMs": 15563,
      "endMs": 32767,
      "durationMs": 17204,
      "fromCache": false
    },
    {
      "sceneId": "S03",
      "narration": "教材在这儿提了可行性研究的四个特点：预见性、公正性、可靠性、科学性。你先混个脸熟，待会儿下一节讲详细可行性研究原则的时候还会跟它呼应。",
      "narrationSha256": "24155e2cdbd6593587f8ec6ded56576d9c230313e23a2e7edf1bfd41a9bba4cf",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S03.wav",
      "wavSha256": "957e9d850cdf5b8626d4d7b852deac0cbbf2bcb0ca111dc5f5a14ad3ba9dbfac",
      "startMs": 32767,
      "endMs": 48560,
      "durationMs": 15793,
      "fromCache": false
    },
    {
      "sceneId": "S04",
      "narration": "那具体从哪几个维度去论证项目可不可行呢？教材在 7.2.1 节列了五大可行性分析维度。过去 11 套真题里，光这一小节就考了 8 道题，是全章当之无愧的第一高频区！",
      "narrationSha256": "5ad148f8d343107fd6959c9e4e0f3b129c6c25336be22a49d0372eaa83f16e7d",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S04.wav",
      "wavSha256": "e171ff593d87e884b120cddbff0350eaec9f23cb91935cf529dc91cb03e6d947",
      "startMs": 48560,
      "endMs": 65292,
      "durationMs": 16732,
      "fromCache": false
    },
    {
      "sceneId": "S05",
      "narration": "为了让大家一下听懂，我们拿一个具体的微场景来串：假设一家医院想上马一套“AI 智能导诊系统”。做可行性研究时，就相当于要戴上五顶帽子去审视它：",
      "narrationSha256": "309bb171fdec6fb0edcafffc8c2b05b3c617093240554282aa1dcff2a0d2b46b",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S05.wav",
      "wavSha256": "42c86d9cb2d64c99ac985799e8afe1e0f75d5dc0455390176a8f07b0db5872f8",
      "startMs": 65292,
      "endMs": 80387,
      "durationMs": 15095,
      "fromCache": false
    },
    {
      "sceneId": "S06",
      "narration": "第一顶，技术可行性——我们现在的条件，能不能在规定时间内把这套系统造出来？第二顶，经济可行性——投入多少钱、能省多少钱，经济账上划不划算？第三顶，社会效益可行性——除了赚钱省钱，对医院内部能力提升、对市民看病就医有什么无形价值？第四顶，运行环境可行性——系统造好之后搬到医院现场，现有的科室制度、医护人员习惯和数据基础，能不能让它顺利跑起来？第五顶，其他方面的可行性——比如软件版权、开源协议、政策法规合不合规？",
      "narrationSha256": "82111e58eaa3c79030546c2891626d409857e9ae49c1b03299f63029e0a5f26e",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S06.wav",
      "wavSha256": "8723bbbcc9a9717bb946e96087f872f649cd7a1a15e241d67c1229b9f7640ea8",
      "startMs": 80387,
      "endMs": 134802,
      "durationMs": 54415,
      "fromCache": false
    },
    {
      "sceneId": "S07",
      "narration": "此类项目更多是由政府或者非营利机构投资，更多强调对于社会的贡献。在实际工作中，其他可行性和运行环境往往具有“一票否决权”，但在考场上，前两项技术与经济依然是分值最高的核心。",
      "narrationSha256": "0e17176d8712ca876c911ed0304218061f43a145225e54b438fb221e62e337ed",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S07.wav",
      "wavSha256": "08d4c362b0f9abbedf46a38237f79e1082c320ab3dc4cc494aabfa58ce1197fe",
      "startMs": 134802,
      "endMs": 155703,
      "durationMs": 20901,
      "fromCache": false
    },
    {
      "sceneId": "S08",
      "narration": "这里额外和大家强调的是技术可行性不仅看先进，更看适用与可控。尤其是在AI快速发展的今天。我们评估技术方案，不能只看能力有多先进，还要看是否适用、风险是否可控。",
      "narrationSha256": "5114a76ecbee38eb7e14f49b383430501f4f15efb8ed9504e51af85ad6bf9bfb",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S08.wav",
      "wavSha256": "e1ee9e8d3b927fc9c982c48ee403f2fed6c9adf5695b99c24e2cf0b4a096eb0e",
      "startMs": 155703,
      "endMs": 174898,
      "durationMs": 19195,
      "fromCache": false
    },
    {
      "sceneId": "S09",
      "narration": "比如，OpenAI 曾披露，一个内部测试模型在查找资料时，未经授权访问了澳大利亚政府的统计服务。",
      "narrationSha256": "e580ea8e288828fe6b1fe08a75634c1808d4d61b530f2a9591de8c216b2ff80e",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S09.wav",
      "wavSha256": "0f36837454064e6c2105aaf84b87a55a41319862faabf4dd642f029bebf73885",
      "startMs": 174898,
      "endMs": 185147,
      "durationMs": 10249,
      "fromCache": false
    },
    {
      "sceneId": "S10",
      "narration": "研究员 Noam Brown 还引用过一个实验：两台已经被攻陷、距离很近的计算机，即使没有网络连接，也可能通过发热和温度传感器传递信息。",
      "narrationSha256": "bea7098f550e435cde7ff6c5ca285d4aeb0f2a66a391ff774a1cf0cbe16b4602",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S10.wav",
      "wavSha256": "a3336fd9229d28bcb13319445c0981a22643fdd1882b3d68b19ce7b8139a77f4",
      "startMs": 185147,
      "endMs": 198561,
      "durationMs": 13414,
      "fromCache": false
    },
    {
      "sceneId": "S11",
      "narration": "下面，我们正式戴上第一顶帽子：技术可行性分析。",
      "narrationSha256": "2bd54ad1f325aef33b7a2ee88e587761ec96ae9417da98b1af4961dacfcbe40d",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S11.wav",
      "wavSha256": "c700366810db596705ece8b5cf6b3cb9c922b14c530bd64ce86020596f82865a",
      "startMs": 198561,
      "endMs": 205106,
      "durationMs": 6545,
      "fromCache": false
    },
    {
      "sceneId": "S12",
      "narration": "它的核心问题很明确：在当前的技术、产品条件限制下，能不能利用现在拥有、或者可能拥有的技术能力、产品功能和人力资源，在规定的时间期限内实现项目的目标、功能和性能？特别提醒了一句：技术可行性往往决定了项目的方向，一旦评估错误，会造成项目根本上的失败。",
      "narrationSha256": "d00b1079fac33d5ce36304c6efa35f38166f273629212ec10147866ae4fb6a8b",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S12.wav",
      "wavSha256": "31a171d2a8c075e166c08d431ed8cc445351c0167792747ec91ac98f2390b989",
      "startMs": 205106,
      "endMs": 232212,
      "durationMs": 27106,
      "fromCache": false
    },
    {
      "sceneId": "S13",
      "narration": "那做技术可行性分析，具体要考虑哪四个因素呢？看屏幕上的四张卡片：第一，进行项目开发的风险——在给定的限制范围和时间期限内，能不能设计出预期系统、实现必需的功能和性能？第三，技术能力的可能性——技术发展趋势和当前掌握的技术支不支持开发，有没有对应的开发环境、平台和工具。第四，物资（产品）的可用性——有没有可以用来建立系统的其他资源，比如设备以及可行的替代产品。",
      "narrationSha256": "076f6086cdc3f74aa8df73bf4e21ccc961ef0f17bfb18d52b428d83bbe4e9d28",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S13.wav",
      "wavSha256": "fd144ace19cab4046a7efae9b63040cf7559573474a64d5077b4183436d88aef",
      "startMs": 232212,
      "endMs": 276385,
      "durationMs": 44173,
      "fromCache": false
    },
    {
      "sceneId": "S14",
      "narration": "第二，人力资源的有效性——请大家在这七个字旁边画三个五角星！这是考场上的头号陷阱！什么叫人力资源的有效性？就是看用于项目开发的技术人员队伍能不能建立起来，存不存在人员不足、技术能力欠缺的问题，能不能在社会上招聘、或者通过培训获得所需要的熟练技术人员。很多同学一看到“招聘人员、培训人员”，脑子一热就去选“运行环境”或者“社会效益”。千万记住：没技术人员就写不出代码、造不出系统！考察能不能凑齐技术人手把系统开发出来，属于技术可行性分析！",
      "narrationSha256": "7368a9bb1fd9578c87e3637d12c81a0de46a037cfb171f56951f7220cbf644f8",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S14.wav",
      "wavSha256": "bb0bc72f89a96cb0d04cd35e88234e7bc5cac8545a0210724754899ffcd3b43c",
      "startMs": 276385,
      "endMs": 325123,
      "durationMs": 48738,
      "fromCache": false
    },
    {
      "sceneId": "S15",
      "narration": "我们马上看 2023 年 5 月的第 21 题，看看命题人是怎么考这个坑的。题干问：可行性报告中，是否存在人力资源不足的问题，是否可以通过社会招聘或培训获得所需人员，属于（  ）的内容？A. 技术可行性分析；B. 经济可行性问题；C. 社会效益可行性分析；D. 运行环境可行性分析。",
      "narrationSha256": "1b1ff8655b0d02ebef072b3cf6fffebfc380e884dc1992bea2f3c426e90883b2",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S15.wav",
      "wavSha256": "910d0b5fb1cfc8bd55ed7c7a955b1dcd7f78be92409cfba59d9aec959747c583",
      "startMs": 325123,
      "endMs": 357635,
      "durationMs": 32512,
      "fromCache": false
    },
    {
      "sceneId": "S16",
      "narration": "现在看这道题，是不是一点都不会犹豫了？",
      "narrationSha256": "ceaa1085471d37b20fdcbca3765870e8ef354a223f9bb61cd27726f0b87aee71",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S16.wav",
      "wavSha256": "82d5692a0dc279ed141e645394ec637c859480750e6c2a3ec74e2ff9a5c187c1",
      "startMs": 357635,
      "endMs": 361943,
      "durationMs": 4308,
      "fromCache": false
    },
    {
      "sceneId": "S17",
      "narration": "题干里的“是否存在人力资源不足、能否通过社会招聘或培训获得所需人员”，完全就是教材里技术可行性分析——人力资源有效性的原话！直接选 A。",
      "narrationSha256": "5a2d18efdf6110e2e09063da6f8db8dc10c4a970e1e0e9d7612de5feb9985d85",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S17.wav",
      "wavSha256": "b6fb48c9246ff386f5c807a5d60fd328feab846311920a35d514b5dffc0b116e",
      "startMs": 361943,
      "endMs": 375622,
      "durationMs": 13679,
      "fromCache": false
    },
    {
      "sceneId": "S18",
      "narration": "接下来戴上第二顶帽子：经济可行性分析。它主要对整个项目的投资和产生的经济效益算四笔账：第一、支出分析，第二、收益分析，第三、收益投资比与投资回收期分析，第四、敏感性分析。",
      "narrationSha256": "7fe3c6bf7390ff3e481ab95611ec21e647566288c99abdc35c02967a365e8f5c",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S18.wav",
      "wavSha256": "72a335cbbd1ec74e63c4eb085440425f78d91af237e9324e5da3db8d3c2efcd2",
      "startMs": 375622,
      "endMs": 398397,
      "durationMs": 22775,
      "fromCache": false
    },
    {
      "sceneId": "S19",
      "narration": "第一笔账，支出分析。教材把项目支出分成了两类，考场上非常喜欢把它们混在一起考：",
      "narrationSha256": "349245baf4982fb6b8838443ecce01449fefde639f385a277206ed82ff5bbf7a",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S19.wav",
      "wavSha256": "63ef5702b240f4eaa243f5802fe45f4b502a16fb9b92717197d13331f7b67e2c",
      "startMs": 398397,
      "endMs": 408586,
      "durationMs": 10189,
      "fromCache": false
    },
    {
      "sceneId": "S20",
      "narration": "一类叫一次性支出——也就是建项目时一次性掏出去的钱，包括：开发费、培训费、差旅费、初始数据录入、设备购置费。",
      "narrationSha256": "2f6ef5c0c54504b13b829545700f83454c2a019e392d5d7da10da69c13c589a5",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S20.wav",
      "wavSha256": "33db359f80f8f41e656abd1537b369404291f402c202c02a99d6945912812b10",
      "startMs": 408586,
      "endMs": 421715,
      "durationMs": 13129,
      "fromCache": false
    },
    {
      "sceneId": "S21",
      "narration": "另一类叫非一次性支出——也就是项目运行期间要周期性、持续掏的钱，包括：软硬件租金、人员工资及福利、水电等公用设施使用费，以及其他消耗品支出。",
      "narrationSha256": "13684c292d1d8d653ae49bbc18c91be250a9c9d02622ba14097c63e0ef4f9f6c",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S21.wav",
      "wavSha256": "d12bc2bdde2fab3d1e6b493b8f89e288338236133b048c17d4931d4fbd9432a7",
      "startMs": 421715,
      "endMs": 439934,
      "durationMs": 18219,
      "fromCache": false
    },
    {
      "sceneId": "S22",
      "narration": "请你特别盯住两个词：“设备购置费”是一次性买断，属于一次性支出；而“软、硬件租金”是按期交租，属于非一次性支出！命题人最爱把“软硬件租金”偷偷塞进一次性支出里骗你。",
      "narrationSha256": "a7a3525715498f39874680af62b3c7318135e41424af818b217c272549f37d66",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S22.wav",
      "wavSha256": "40dae0071b6cfdc9e3cb02289b6cc05d7e28b347504c0fd228f3ac79f32ba135",
      "startMs": 439934,
      "endMs": 458666,
      "durationMs": 18732,
      "fromCache": false
    },
    {
      "sceneId": "S23",
      "narration": "第二笔账，收益分析，分三小类：直接收益（比如销售项目产品的收入）、间接收益（比如通过项目实施降低了成本）、其他收益（比如获得了知识产权、软件著作权）。",
      "narrationSha256": "05be598b195dbbf77acd25132ff65ce0f67700bae3adaf3f2baa69fc002d42f9",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S23.wav",
      "wavSha256": "e99f02dd225b9dbedb3b9dc94b8ff2ef8f527a6e1435ead47418329538f3875a",
      "startMs": 458666,
      "endMs": 476720,
      "durationMs": 18054,
      "fromCache": false
    },
    {
      "sceneId": "S24",
      "narration": "第三笔账，收益投资比、投资回收期分析，对比投入产出，算收益率和回收期。",
      "narrationSha256": "2ffa3e5116be63ed7234b7deceb68c4ee672dd588f4001b6e3f3b07fba407677",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S24.wav",
      "wavSha256": "6e7c58331a1803eecd6a6c8d27628870f1683aacccf40175adc21eb839d6caa6",
      "startMs": 476720,
      "endMs": 485578,
      "durationMs": 8858,
      "fromCache": false
    },
    {
      "sceneId": "S25",
      "narration": "第四笔账，敏感性分析——什么叫敏感性分析？就是当设备和软件配置、处理速度要求、系统的工作负荷类型和负荷量这些关键性因素发生变化时，估计一下会对支出和收益产生多大影响。",
      "narrationSha256": "9d1d111de8be984a62872886fb87c75c911afdd746e18430afb96066b6b585b2",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S25.wav",
      "wavSha256": "5738d36a8eb29af19df53ba4512422f6faf63743710ba7b1ac2f7202c4e9dbfe",
      "startMs": 485578,
      "endMs": 505222,
      "durationMs": 19644,
      "fromCache": false
    },
    {
      "sceneId": "S26",
      "narration": "我们连看两道真题，看看这四笔账在考场上怎么出题。先看 2023 年 11 月第 1 批次的第 28 题：问关于经济可行性分析，描述错误的是哪一项？",
      "narrationSha256": "ecba4128397ae89e2a0b980b3b13a236ca056c5152b88291fb05cdf367229e83",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S26.wav",
      "wavSha256": "0f308dbdf40b02aefafcac3d7b1105d1edb21c564cdaf2574095ed95767350a5",
      "startMs": 505222,
      "endMs": 520290,
      "durationMs": 15068,
      "fromCache": false
    },
    {
      "sceneId": "S27",
      "narration": "你看 A 选项：“一次性支出包括开发费、培训费、差旅费、软、硬件租金等费用”——抓到了吧！把“软、硬件租金”混进一次性支出里了，软硬件租金是非一次性支出，所以直接选 A！而 B 间接收益、C 销售产品收入为直接收益、D 收益投资比与投资回收期，全都是教材原话。",
      "narrationSha256": "ccf642b909fcd2501d9f55295b6c67ae99cb88024e8463e182e8884237036f85",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S27.wav",
      "wavSha256": "37be44d27bb6378560f4a65a323fb88808e31b3781fd23ee518b2877d375fb7d",
      "startMs": 520290,
      "endMs": 551710,
      "durationMs": 31420,
      "fromCache": false
    },
    {
      "sceneId": "S28",
      "narration": "再看旁边的 2023 年 11 月第 4 批次第 22 题：经济可行性分析具体包括支出分析、收益分析、投资回报分析以及（  ）等？A. 敏感性分析；B. 公共效益分析；C. 品牌效益；D. 技术创新效益。",
      "narrationSha256": "52f159c69864003f2a04985753c9687c60a4792b50752afa0e669013c915bc73",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S28.wav",
      "wavSha256": "e392df11fb2877b2095aae552242999adf44b5d11f7ec7f9c5d404b6dc7fc43b",
      "startMs": 551710,
      "endMs": 575577,
      "durationMs": 23867,
      "fromCache": false
    },
    {
      "sceneId": "S29",
      "narration": "直接选 A 敏感性分析！同样，23 年 11 月第 3 批次第 22 题反过来问“经济可行性不包括什么”，把刚学过的“人力资源的有效性分析”塞了进来。你看，只要这四笔账的框架在脑子里，正着考反着考都难不倒你。",
      "narrationSha256": "b02e03fb142fb84d77941a15c12987473228c1ebb3b2992b98dfc2b4e619e7ed",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S29.wav",
      "wavSha256": "f363fbf79681f08ce346110f0a22c53c619ab485e3bc7781a0c6f04bb53f025a",
      "startMs": 575577,
      "endMs": 598022,
      "durationMs": 22445,
      "fromCache": false
    },
    {
      "sceneId": "S30",
      "narration": "刚才那道题的 B、C、D 选项出现了“公共效益、品牌效益、技术创新效益”，它们属于哪儿呢？这就到了第三顶帽子——社会效益可行性分析。",
      "narrationSha256": "9082f88a66d9105868230c150cc13a215c0adbb95112a3f3827133253719ce5b",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S30.wav",
      "wavSha256": "dc73e08f4d914c611fe93b4029361aa1bf14ee4cb2007d32ba55a65f40a41ee6",
      "startMs": 598022,
      "endMs": 613652,
      "durationMs": 15630,
      "fromCache": false
    },
    {
      "sceneId": "S31",
      "narration": "尤其是面向公共服务领域的项目，社会效益往往是关注重点。第四版教材把社会效益分成了“对组织内部”和“对社会发展”两大块，每块各有 5 项：",
      "narrationSha256": "1962ec6cb9df9500f56623f9788632f6e1149c0a323a9ff5de8d37d58e9b0bb2",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S31.wav",
      "wavSha256": "2bd26ac65c368db5eeff6ba54b1364459898c7b813deb064330d869f5abb30fa",
      "startMs": 613652,
      "endMs": 630906,
      "durationMs": 17254,
      "fromCache": false
    },
    {
      "sceneId": "S32",
      "narration": "先看对组织内部带来的知识经验沉淀，一共 5 个效益：第一，品牌效益（提升知名度）；第二，竞争力效益（获得行业竞争优势）；第三，技术创新效益（攻克技术难点，带来技术能力积累、产品与服务创新）；第四，人员提升收益（通过项目锻炼，带来人员能力提升或骨干人员培育）；第五，管理提升效益（过程管控带来组织管理水平提升）。",
      "narrationSha256": "6207eca76aa0a36f4f33d389ea048ee91ad83069c6db9beb1d87919de4a168ad",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S32.wav",
      "wavSha256": "39423efb40c3be97da903b75596b2991ffebcfc0b7515b2c6c76ecc208234155",
      "startMs": 630906,
      "endMs": 668096,
      "durationMs": 37190,
      "fromCache": false
    },
    {
      "sceneId": "S33",
      "narration": "再看对社会发展带来的进步，也是 5 个：公共效益（信息惠民、美好生活、居民健康等）、文化效益（精神文明、网络文明）、环境效益（保护自然与生态）、社会责任感效益，以及其他收益（如提高国防能力、保障国家和社会安全）。",
      "narrationSha256": "a2f8ae78ce75715cbe25c882e972276c7bcecc0c42c5792f5356440b976ecb1d",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S33.wav",
      "wavSha256": "1edb143145bddd0f7bc4770746ba770ba60136f75cf6b7784f0a316ee5ddead3",
      "startMs": 668096,
      "endMs": 693989,
      "durationMs": 25893,
      "fromCache": false
    },
    {
      "sceneId": "S34",
      "narration": "看到这儿，最精彩的地方来了！你发现没有：在“对组织内部的社会效益”里，有“人员提升收益”和“技术创新效益”；而在前面讲的“技术可行性”里，有“人力资源的有效性”和“技术能力的可能性”！命题人简直太爱拿这两组词交叉挖坑了！我们用屏幕下方这张终极防坑表把它们彻底锁死：",
      "narrationSha256": "5fdb9ea3f8dc020786291e08ecf25b048ae3b2f86eb847e6211d69c0162d166e",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S34.wav",
      "wavSha256": "b958e743893e5586cf832861cf804e4dea6f23a2c35bf1b8cc801a4eb24ddbd2",
      "startMs": 693989,
      "endMs": 721254,
      "durationMs": 27265,
      "fromCache": false
    },
    {
      "sceneId": "S35",
      "narration": "- 问你“人力资源的有效性（能不能招到或培训出技术人员把系统做出来）”，选技术可行性；- 问你“人员提升收益（通过做项目锻炼了队伍、培养了骨干）”，选社会效益可行性！- 问你“技术能力的可能性（当前掌握的技术和工具支不支持开发）”，选技术可行性；- 问你“技术创新效益（攻克难点为组织积累了技术能力与创新）”，选社会效益可行性！",
      "narrationSha256": "54e2651f1122abf968176e245d0498561a73b668838b5d7395afca74f7979157",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S35.wav",
      "wavSha256": "1c831619eb1fcbfbf92b74b12539364f74444aaa132fcd62c663314f354432c9",
      "startMs": 721254,
      "endMs": 755243,
      "durationMs": 33989,
      "fromCache": false
    },
    {
      "sceneId": "S36",
      "narration": "接下来看屏幕上这两道真题对决：左边是 2023 年 11 月第 1 批次第 61 题：问哪一项属于社会效益可行性研究的内容？A 是人力资源的有效性，D 是人员提升收益。选哪个？直接选 D 人员提升收益！",
      "narrationSha256": "48efe30e716a0ba641710ea344ff63be39a49d3a909681fc2c1fc96083377df5",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S36.wav",
      "wavSha256": "51c866fa136a548938f124e920cab612bd146378f6b7141fb6edddc2e5d95be8",
      "startMs": 755243,
      "endMs": 776118,
      "durationMs": 20875,
      "fromCache": false
    },
    {
      "sceneId": "S37",
      "narration": "右边是 2026 年 5 月第 2 批次第 23 题：问技术可行性分析考虑的因素不包括哪一项？A 人力资源的有效性、B 物资的可用性、C 技术能力的可能性、D 技术创新效益。不包括哪个？直接选 D 技术创新效益，因为它属于社会效益！这两道题放在一起看，是不是一下子通透了？",
      "narrationSha256": "55e3a18fba96502cb722b1d26ee8585389205dadea173b673ba0f6e822e3f7b9",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S37.wav",
      "wavSha256": "f67993ce85728477953db04be907ac55302b7a8c19bee4f5bc5218f0a328ccff",
      "startMs": 776118,
      "endMs": 805696,
      "durationMs": 29578,
      "fromCache": false
    },
    {
      "sceneId": "S38",
      "narration": "最后我们来看第四顶和第五顶帽子。第四顶帽子叫运行环境可行性分析。信息系统项目跟修桥修路不一样，软件硬件造好了，还得安装运行在用户现场。运行环境是制约信息系统发挥效益的关键。那运行环境可行性到底看什么？既有“硬环境”，更有用户的“软环境”：需要从用户的管理体制、管理方法、规章制度、工作习惯、人员素质（甚至包括人员的心理承受能力、接受新知识和技能的积极性）、数据资源积累、基础软硬件平台等多方面进行评估，看系统交付以后能不能在用户现场顺利运行。如果软硬件运行环境需要重新建立，就要评估能不能建立起来，并把建立环境的工作纳入项目计划之中。",
      "narrationSha256": "6b901fce104353dd386fb8c57a16263c1c96806ba104eb81adfa878d7a870871",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S38.wav",
      "wavSha256": "671e63edc4eead3249f497f6ac6a16c115248abd3f1579b15298b27ac04cd247",
      "startMs": 805696,
      "endMs": 865073,
      "durationMs": 59377,
      "fromCache": false
    },
    {
      "sceneId": "S39",
      "narration": "第五顶帽子叫其他方面的可行性分析，主要包括法律可行性、政策可行性等。比如合同责任、知识产权，特别是开发环境、平台、工具和产品功能里涉及的软件版权问题（像能不能购买工具版权、开源协议符不符合商业目标等），以及对社会环境、自然环境的影响。",
      "narrationSha256": "3de347532057dbcc5a545f8801f1463c8c60f554f3c3a5258b311164f8d6435a",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S39.wav",
      "wavSha256": "00ffd9a9be86e2155f06d88b2d18edabec2a95e3e86e3a6c8271d415119b59f5",
      "startMs": 865073,
      "endMs": 891122,
      "durationMs": 26049,
      "fromCache": false
    },
    {
      "sceneId": "S40",
      "narration": "我们用 2025 年 5 月第 1 批次的第 58 题来做个完美收官。这道题出得特别好，四个选项刚好把我们今天学的几个维度全串起来了！题目问：在项目可行性分析的过程中，哪一项属于运行环境可行性分析的内容？A. 项目能否为组织带来技术创新效益；B. 设备购置费是否超出预算；C. 系统使用的开源协议是否符合项目商业目标；D. 用户的管理体制、人员素质及数据资源积累。",
      "narrationSha256": "4080ea18c63983dc08e12a1f56bb9396af0ca4d897f3cbfeb98a1f640a85471e",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S40.wav",
      "wavSha256": "769859b4d9fd6ecb4e0f5e868e7c2b3a73e9cfda8d1eb55628aaa3398c55e57c",
      "startMs": 891122,
      "endMs": 932795,
      "durationMs": 41673,
      "fromCache": false
    },
    {
      "sceneId": "S41",
      "narration": "我们挨个认认门：A“技术创新效益”，刚讲过，属于社会效益可行性（对组织内部）；B“设备购置费”，属于经济可行性（一次性支出）；C“开源协议是否符合商业目标”，涉及知识产权与软件版权许可，属于其他（法律）可行性；只有 D“用户的管理体制、人员素质及数据资源积累”，完完全全是运行环境可行性分析的内容！选 D。",
      "narrationSha256": "a1ed57afd547a28029fff5c1d44d96c00b405d43012fa1abcef4a4b509e19231",
      "wavPath": "/projects/gaoxiang/course-video-pipeline-Gemini/workspaces/ch07-L02-ds/audio/S41.wav",
      "wavSha256": "e33032340a4bf35b44ba5e362bc54fd8c1f7e918d9a27862825646f53c6ce071",
      "startMs": 932795,
      "endMs": 966230,
      "durationMs": 33435,
      "fromCache": false
    },
    {
      "sceneId": "S42",
      "narration": "到这里，可行性研究算哪五笔账我们就彻底摸透了。但在实际工作中，可行性研究为什么要分“初步可研”和“详细可研”两步走？做完了可研，为什么还要请第三方来做“项目评估”？我们下一节见！",
      "narrationSha256": "b8634fc3913c9fb63d2c56ce76ee0284ca1819d6ce166bb41ad62876576584b9",
