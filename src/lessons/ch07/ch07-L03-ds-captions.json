[
  {
    "index": 1,
    "sceneId": "S01",
    "text": "上一节我们戴上五顶帽子，",
    "startMs": 0,
    "endMs": 2000
  },
  {
    "index": 2,
    "sceneId": "S01",
    "text": "搞清楚了可行性研究要算哪五笔账。",
    "startMs": 2320,
    "endMs": 5760
  },
  {
    "index": 3,
    "sceneId": "S01",
    "text": "但对于大型或者比较复杂的项目，",
    "startMs": 6240,
    "endMs": 9120
  },
  {
    "index": 4,
    "sceneId": "S01",
    "text": "如果一上来就全方位深挖，",
    "startMs": 9440,
    "endMs": 11760
  },
  {
    "index": 5,
    "sceneId": "S01",
    "text": "既费时又费钱。",
    "startMs": 12000,
    "endMs": 13840
  },
  {
    "index": 6,
    "sceneId": "S01",
    "text": "所以在实际工作里，往往先做一步 7.2.2 初步可行性研究。",
    "startMs": 14400,
    "endMs": 20320
  },
  {
    "index": 7,
    "sceneId": "S02",
    "text": "初步可行性研究是在对市场或客户情况调查后做的初步评估，",
    "startMs": 20992,
    "endMs": 26432
  },
  {
    "index": 8,
    "sceneId": "S02",
    "text": "主要用来衡量三件事：第一，",
    "startMs": 26752,
    "endMs": 29632
  },
  {
    "index": 9,
    "sceneId": "S02",
    "text": "分析项目前途，决定值不值得继续深入做详细研究；",
    "startMs": 29952,
    "endMs": 34352
  },
  {
    "index": 10,
    "sceneId": "S02",
    "text": "第二，初步估计项目里的关键技术及核心问题；",
    "startMs": 34752,
    "endMs": 38752
  },
  {
    "index": 11,
    "sceneId": "S02",
    "text": "第三，初步估计必须进行的辅助研究，",
    "startMs": 39232,
    "endMs": 42912
  },
  {
    "index": 12,
    "sceneId": "S02",
    "text": "并判断有没有必要的技术、",
    "startMs": 43392,
    "endMs": 45072
  },
  {
    "index": 13,
    "sceneId": "S02",
    "text": "实验、人力条件支持。",
    "startMs": 45472,
    "endMs": 48112
  },
  {
    "index": 14,
    "sceneId": "S03",
    "text": "这里请大家盯紧《初步可行性研究报告》的三个考场高频细节：",
    "startMs": 48766,
    "endMs": 53406
  },
  {
    "index": 15,
    "sceneId": "S03",
    "text": "第一，它的结果和主要内容，",
    "startMs": 53806,
    "endMs": 56686
  },
  {
    "index": 16,
    "sceneId": "S03",
    "text": "跟详细可行性研究基本相同！",
    "startMs": 57006,
    "endMs": 59806
  },
  {
    "index": 17,
    "sceneId": "S03",
    "text": "区别只在于占有的资源和研究细节有较大差异。",
    "startMs": 60286,
    "endMs": 64126
  },
  {
    "index": 18,
    "sceneId": "S03",
    "text": "第二，它的主要内容一共有 6 项：",
    "startMs": 64686,
    "endMs": 68286
  },
  {
    "index": 19,
    "sceneId": "S03",
    "text": "需求与市场预测、设备与资源投入分析、",
    "startMs": 68606,
    "endMs": 73486
  },
  {
    "index": 20,
    "sceneId": "S03",
    "text": "空间布局、项目设计、项目进度安排、",
    "startMs": 73806,
    "endMs": 78926
  },
  {
    "index": 21,
    "sceneId": "S03",
    "text": "项目投资与成本估算。",
    "startMs": 79246,
    "endMs": 80926
  },
  {
    "index": 22,
    "sceneId": "S03",
    "text": "注意：可以通过捷径来决定次要成本，",
    "startMs": 81406,
    "endMs": 85006
  },
  {
    "index": 23,
    "sceneId": "S03",
    "text": "但必须把估计项目的“主要投资支出和生产成本”作为初步可研的一部分，",
    "startMs": 85406,
    "endMs": 91486
  },
  {
    "index": 24,
    "sceneId": "S03",
    "text": "而且里面明确包含项目进度安排！",
    "startMs": 91886,
    "endMs": 94766
  },
  {
    "index": 25,
    "sceneId": "S03",
    "text": "第三，初步可研报告可以作为正式文献供项目决策参考，",
    "startMs": 95246,
    "endMs": 100286
  },
  {
    "index": 26,
    "sceneId": "S03",
    "text": "也是进一步做详细可研的基础。",
    "startMs": 100606,
    "endMs": 103086
  },
  {
    "index": 27,
    "sceneId": "S04",
    "text": "刚才提到了一个词叫“辅助（功能）研究”。",
    "startMs": 103770,
    "endMs": 108170
  },
  {
    "index": 28,
    "sceneId": "S04",
    "text": "它只研究项目的一个或几个方面，",
    "startMs": 108730,
    "endMs": 111290
  },
  {
    "index": 29,
    "sceneId": "S04",
    "text": "不是所有方面，只能作为初步可研、",
    "startMs": 111690,
    "endMs": 115130
  },
  {
    "index": 30,
    "sceneId": "S04",
    "text": "详细可研和大规模投资建议的前提或辅助。",
    "startMs": 115450,
    "endMs": 119130
  },
  {
    "index": 31,
    "sceneId": "S04",
    "text": "而且记住：辅助研究的费用，",
    "startMs": 119690,
    "endMs": 122410
  },
  {
    "index": 32,
    "sceneId": "S04",
    "text": "必须和项目可行性研究的费用一并考虑，",
    "startMs": 122810,
    "endMs": 125850
  },
  {
    "index": 33,
    "sceneId": "S04",
    "text": "因为它的目的之一就是在可研阶段省钱。",
    "startMs": 126250,
    "endMs": 129450
  },
  {
    "index": 34,
    "sceneId": "S05",
    "text": "教材列了辅助研究的 6 种分类，",
    "startMs": 130083,
    "endMs": 133123
  },
  {
    "index": 35,
    "sceneId": "S05",
    "text": "不用死背长段解释，重点认准名字，",
    "startMs": 133443,
    "endMs": 136643
  },
  {
    "index": 36,
    "sceneId": "S05",
    "text": "特别是第三条：第一、产品的市场研究，",
    "startMs": 137043,
    "endMs": 141123
  },
  {
    "index": 37,
    "sceneId": "S05",
    "text": "第二、配件和投入物资研究，",
    "startMs": 141443,
    "endMs": 144083
  },
  {
    "index": 38,
    "sceneId": "S05",
    "text": "第三、试验室和中间工厂的试验，",
    "startMs": 144403,
    "endMs": 147843
  },
  {
    "index": 39,
    "sceneId": "S05",
    "text": "第四、网络物理布局设计，",
    "startMs": 148163,
    "endMs": 150723
  },
  {
    "index": 40,
    "sceneId": "S05",
    "text": "第五、规模的经济性研究，",
    "startMs": 151203,
    "endMs": 154163
  },
  {
    "index": 41,
    "sceneId": "S05",
    "text": "第六、设备选择研究。",
    "startMs": 154483,
    "endMs": 156563
  },
  {
    "index": 42,
    "sceneId": "S05",
    "text": "为什么特别标红“试验室和中间工厂的试验”？",
    "startMs": 157123,
    "endMs": 160803
  },
  {
    "index": 43,
    "sceneId": "S05",
    "text": "因为考题最喜欢把它张冠李戴成“初步可行性研究的主要内容”！",
    "startMs": 161283,
    "endMs": 166563
  },
  {
    "index": 44,
    "sceneId": "S06",
    "text": "我们把 2024 年 5 月第一批次和第二批次的两道真题放在一起做，",
    "startMs": 167256,
    "endMs": 172536
  },
  {
    "index": 45,
    "sceneId": "S06",
    "text": "你看看真题是怎么考的！",
    "startMs": 172856,
    "endMs": 174456
  },
  {
    "index": 46,
    "sceneId": "S06",
    "text": "先看左边第一批次第 17 题，",
    "startMs": 175016,
    "endMs": 177336
  },
  {
    "index": 47,
    "sceneId": "S06",
    "text": "问描述正确的是：",
    "startMs": 177656,
    "endMs": 179176
  },
  {
    "index": 48,
    "sceneId": "S08",
    "text": "A 说“试验室和中间工厂的试验是初步可行性研究的主要内容”—",
    "startMs": 182947,
    "endMs": 188840
  },
  {
    "index": 49,
    "sceneId": "S08",
    "text": "—刚提醒过，",
    "startMs": 188840,
    "endMs": 189747
  },
  {
    "index": 50,
    "sceneId": "S08",
    "text": "这是辅助研究，错！",
    "startMs": 190067,
    "endMs": 191907
  },
  {
    "index": 51,
    "sceneId": "S08",
    "text": "B 把“初步评估”安到了详细可研头上，",
    "startMs": 192387,
    "endMs": 195587
  },
  {
    "index": 52,
    "sceneId": "S08",
    "text": "反了！C 说“初步可研与详细可研在占有资源和研究细节方面是相同的”—",
    "startMs": 195907,
    "endMs": 204554
  },
  {
    "index": 53,
    "sceneId": "S08",
    "text": "—正好说反，",
    "startMs": 204554,
    "endMs": 205747
  },
  {
    "index": 54,
    "sceneId": "S08",
    "text": "它们在占有资源和研究细节上有较大差异！",
    "startMs": 206067,
    "endMs": 209747
  },
  {
    "index": 55,
    "sceneId": "S08",
    "text": "D 说“初步可研可初步估计必须进行的辅助研究，",
    "startMs": 210227,
    "endMs": 215587
  },
  {
    "index": 56,
    "sceneId": "S08",
    "text": "并判断支持条件”，完全正确，",
    "startMs": 215827,
    "endMs": 218467
  },
  {
    "index": 57,
    "sceneId": "S09",
    "text": "再看右边第二批次第 19 题，",
    "startMs": 220253,
    "endMs": 223133
  },
  {
    "index": 58,
    "sceneId": "S09",
    "text": "问描述不正确的是：",
    "startMs": 223453,
    "endMs": 224893
  },
  {
    "index": 59,
    "sceneId": "S11",
    "text": "A 包含主要投资支出、B 可作为正式文件支持决策、",
    "startMs": 228582,
    "endMs": 234662
  },
  {
    "index": 60,
    "sceneId": "S11",
    "text": "D 是详细可研的基础，全对；",
    "startMs": 234982,
    "endMs": 238262
  },
  {
    "index": 61,
    "sceneId": "S11",
    "text": "唯独 C 说“初步可研报告的核心内容不包括项目进度安排”——显然错误，",
    "startMs": 238662,
    "endMs": 246503
  },
  {
    "index": 62,
    "sceneId": "S11",
    "text": "那 6 项主要内容里明明白白写着“项目进度安排”！",
    "startMs": 246822,
    "endMs": 252502
  },
  {
    "index": 63,
    "sceneId": "S11",
    "text": "直接选 C。",
    "startMs": 252982,
    "endMs": 253702
  },
  {
    "index": 64,
    "sceneId": "S11",
    "text": "再顺带提一句，",
    "startMs": 254262,
    "endMs": 255928
  },
  {
    "index": 65,
    "sceneId": "S11",
    "text": "23 年 11 月第 2 批次第 14 题说“初步可行性分析是必不可少的”，",
    "startMs": 255928,
    "endMs": 263702
  },
  {
    "index": 66,
    "sceneId": "S11",
    "text": "也是错的，因为必不可少的是详细可行性研究！",
    "startMs": 264022,
    "endMs": 268182
  },
  {
    "index": 67,
    "sceneId": "S12",
    "text": "过了初步可研，就进入绝对不能省的 7.2.3 详细可行性研究。",
    "startMs": 268925,
    "endMs": 274925
  },
  {
    "index": 68,
    "sceneId": "S12",
    "text": "它提交的《可行性研究报告》直接成为后面项目评估和决策的依据。",
    "startMs": 275485,
    "endMs": 280445
  },
  {
    "index": 69,
    "sceneId": "S13",
    "text": "这一节文字很长，我帮大家提炼出考场上最核心的四个硬核考点：",
    "startMs": 281080,
    "endMs": 286680
  },
  {
    "index": 70,
    "sceneId": "S13",
    "text": "第一，依据与三原则。",
    "startMs": 287080,
    "endMs": 290280
  },
  {
    "index": 71,
    "sceneId": "S13",
    "text": "详细可研依据包括国家规划、",
    "startMs": 290760,
    "endMs": 293560
  },
  {
    "index": 72,
    "sceneId": "S13",
    "text": "政策法规、批复、项目建议书或意向性协议、",
    "startMs": 293880,
    "endMs": 299000
  },
  {
    "index": 73,
    "sceneId": "S13",
    "text": "信息化规划标准、市场调研报告和技术资料等 7 项；",
    "startMs": 299320,
    "endMs": 304840
  },
  {
    "index": 74,
    "sceneId": "S13",
    "text": "遵循三个基本原则：科学性原则（数据真实可靠、",
    "startMs": 305240,
    "endMs": 310600
  },
  {
    "index": 75,
    "sceneId": "S13",
    "text": "有科学依据）、客观性原则（实事求是、",
    "startMs": 310920,
    "endMs": 315160
  },
  {
    "index": 76,
    "sceneId": "S13",
    "text": "排除主观臆断）、公正性原则（国家人民利益首位、",
    "startMs": 315560,
    "endMs": 320920
  },
  {
    "index": 77,
    "sceneId": "S13",
    "text": "不偏不倚）。",
    "startMs": 321400,
    "endMs": 322680
  },
  {
    "index": 78,
    "sceneId": "S14",
    "text": "第二，两个核心方法：一个是投资估算法（分数量性估算/比例估算法、",
    "startMs": 323318,
    "endMs": 330678
  },
  {
    "index": 79,
    "sceneId": "S14",
    "text": "研究性估算、预算性估算、",
    "startMs": 330998,
    "endMs": 334118
  },
  {
    "index": 80,
    "sceneId": "S14",
    "text": "投标估算）；另一个请重点圈出来，",
    "startMs": 334438,
    "endMs": 337798
  },
  {
    "index": 81,
    "sceneId": "S14",
    "text": "叫增量净效益法，又叫“有无比较法”！",
    "startMs": 338038,
    "endMs": 342598
  },
  {
    "index": 82,
    "sceneId": "S15",
    "text": "什么叫“有无比较法”？",
    "startMs": 343248,
    "endMs": 345168
  },
  {
    "index": 83,
    "sceneId": "S15",
    "text": "就是把“有项目时的成本/效益”跟“无项目时的成本/效益”作动态比较，",
    "startMs": 345648,
    "endMs": 352608
  },
  {
    "index": 84,
    "sceneId": "S15",
    "text": "求差额（增量）。",
    "startMs": 352928,
    "endMs": 354768
  },
  {
    "index": 85,
    "sceneId": "S15",
    "text": "教材特别强调：“有无比较法”比传统的“前后比较法”更科学、",
    "startMs": 355248,
    "endMs": 360608
  },
  {
    "index": 86,
    "sceneId": "S15",
    "text": "更准确！为什么？",
    "startMs": 360928,
    "endMs": 363088
  },
  {
    "index": 87,
    "sceneId": "S15",
    "text": "因为“前后比较法”只拿上项目前和上项目后比，",
    "startMs": 363568,
    "endMs": 369088
  },
  {
    "index": 88,
    "sceneId": "S15",
    "text": "没考虑就算不上这个项目，",
    "startMs": 369328,
    "endMs": 371248
  },
  {
    "index": 89,
    "sceneId": "S15",
    "text": "组织原本也会发生变化，",
    "startMs": 371648,
    "endMs": 373728
  },
  {
    "index": 90,
    "sceneId": "S15",
    "text": "容易夸大或低估项目效益。",
    "startMs": 373968,
    "endMs": 377009
  },
  {
    "index": 91,
    "sceneId": "S16",
    "text": "第三，四个阶段的估算精度阶梯。",
    "startMs": 377812,
    "endMs": 380852
  },
  {
    "index": 92,
    "sceneId": "S16",
    "text": "在详细可研的 7 项内容（市场需求预测、",
    "startMs": 381332,
    "endMs": 385572
  },
  {
    "index": 93,
    "sceneId": "S16",
    "text": "部件投入选择、架构与技术方案——",
    "startMs": 385892,
    "endMs": 390225
  },
  {
    "index": 94,
    "sceneId": "S16",
    "text": "注意技术评价看先进性/实用性/可靠性/连锁效果/危害性、",
    "startMs": 390225,
    "endMs": 397892
  },
  {
    "index": 95,
    "sceneId": "S16",
    "text": "技术与设备选择、网络物理布局、",
    "startMs": 398212,
    "endMs": 401972
  },
  {
    "index": 96,
    "sceneId": "S16",
    "text": "投资成本与资金筹措、经济评价及综合分析）里，",
    "startMs": 402372,
    "endMs": 406612
  },
  {
    "index": 97,
    "sceneId": "S16",
    "text": "有一组非常经典的估算精度数字：",
    "startMs": 407012,
    "endMs": 409652
  },
  {
    "index": 98,
    "sceneId": "S16",
    "text": "- 毛估和粗估：精度在正负 30%；",
    "startMs": 410052,
    "endMs": 414132
  },
  {
    "index": 99,
    "sceneId": "S16",
    "text": "- 初步可行性研究：精度要求在正负 20%；",
    "startMs": 414132,
    "endMs": 419332
  },
  {
    "index": 100,
    "sceneId": "S16",
    "text": "- 详细可行性研究：精度要求在正负 10%；",
    "startMs": 419332,
    "endMs": 424532
  },
  {
    "index": 101,
    "sceneId": "S16",
    "text": "- 设计开发阶段：精度要达到正负 5%。",
    "startMs": 424692,
    "endMs": 429652
  },
  {
    "index": 102,
    "sceneId": "S17",
    "text": "顺带记住几个财务常识：",
    "startMs": 430399,
    "endMs": 432239
  },
  {
    "index": 103,
    "sceneId": "S17",
    "text": "投资费用等于固定资本加上净周转资金（流动资产减短期负债）；",
    "startMs": 432639,
    "endMs": 440719
  },
  {
    "index": 104,
    "sceneId": "S17",
    "text": "大型项目自筹与贷款一般各半稳妥，",
    "startMs": 441119,
    "endMs": 444719
  },
  {
    "index": 105,
    "sceneId": "S17",
    "text": "自筹不足多贷款限额通常是 50% 到 80%；",
    "startMs": 444959,
    "endMs": 449040
  },
  {
    "index": 106,
    "sceneId": "S17",
    "text": "项目总成本分四大类（研发成本、",
    "startMs": 449359,
    "endMs": 453679
  },
  {
    "index": 107,
    "sceneId": "S17",
    "text": "行政管理费、销售与分销费用、",
    "startMs": 453999,
    "endMs": 457279
  },
  {
    "index": 108,
    "sceneId": "S17",
    "text": "财务费用和折旧），其中前三类加起来叫做“经营成本”；",
    "startMs": 457599,
    "endMs": 462079
  },
  {
    "index": 109,
    "sceneId": "S17",
    "text": "财务报表通常包括现金流动表、",
    "startMs": 462559,
    "endMs": 466159
  },
  {
    "index": 110,
    "sceneId": "S17",
    "text": "净收入报表和预计资产负债表。",
    "startMs": 466479,
    "endMs": 469039
  },
  {
    "index": 111,
    "sceneId": "S18",
    "text": "第四，组织经济评价对比国民经济评价：",
    "startMs": 469685,
    "endMs": 473685
  },
  {
    "index": 112,
    "sceneId": "S18",
    "text": "- 组织经济评价站在企业角度算盈利，",
    "startMs": 474085,
    "endMs": 477365
  },
  {
    "index": 113,
    "sceneId": "S18",
    "text": "分静态方法（投资收益率、",
    "startMs": 477685,
    "endMs": 480725
  },
  {
    "index": 114,
    "sceneId": "S18",
    "text": "投资回收期）和动态方法（净现值法 NPV、",
    "startMs": 481045,
    "endMs": 486165
  },
  {
    "index": 115,
    "sceneId": "S18",
    "text": "内部收益率法 IRR、外部收益率法、",
    "startMs": 486485,
    "endMs": 490725
  },
  {
    "index": 116,
    "sceneId": "S18",
    "text": "动态投资回收期法、收益/成本比值法，",
    "startMs": 490965,
    "endMs": 495445
  },
  {
    "index": 117,
    "sceneId": "S18",
    "text": "考虑资金时间价值，第 21 章会专门算）。",
    "startMs": 495765,
    "endMs": 499765
  },
  {
    "index": 118,
    "sceneId": "S18",
    "text": "- 国民经济评价站在国家和社会全局视角，",
    "startMs": 500245,
    "endMs": 504485
  },
  {
    "index": 119,
    "sceneId": "S18",
    "text": "有个极特殊的考点：与组织经济评价不同，",
    "startMs": 504805,
    "endMs": 508245
  },
  {
    "index": 120,
    "sceneId": "S18",
    "text": "国民经济评价把“工资、利息、",
    "startMs": 508565,
    "endMs": 512485
  },
  {
    "index": 121,
    "sceneId": "S18",
    "text": "税金”算作国家收益，采用社会价格和社会贴现率！",
    "startMs": 512965,
    "endMs": 518085
  },
  {
    "index": 122,
    "sceneId": "S19",
    "text": "至于教材表 7-1 的《详细可行性研究报告结构示例》，",
    "startMs": 518771,
    "endMs": 523491
  },
  {
    "index": 123,
    "sceneId": "S19",
    "text": "你只需知道它视项目规模和性质有简有繁，",
    "startMs": 523731,
    "endMs": 528691
  },
  {
    "index": 124,
    "sceneId": "S19",
    "text": "包含背景、结论、技术、市场、",
    "startMs": 529011,
    "endMs": 533411
  },
  {
    "index": 125,
    "sceneId": "S19",
    "text": "目标、进度、投资、人员、风险、",
    "startMs": 533731,
    "endMs": 538531
  },
  {
    "index": 126,
    "sceneId": "S19",
    "text": "经济与社会效益等模块即可。",
    "startMs": 539011,
    "endMs": 541331
  },
  {
    "index": 127,
    "sceneId": "S20",
    "text": "好，现在建设单位把厚厚一本《详细可行性研究报告》写完了，",
    "startMs": 541987,
    "endMs": 547187
  },
  {
    "index": 128,
    "sceneId": "S20",
    "text": "能不能直接拿着它去领钱开工？",
    "startMs": 547507,
    "endMs": 549827
  },
  {
    "index": 129,
    "sceneId": "S20",
    "text": "不行！因为可研报告是建设单位自己（或找人）写的，",
    "startMs": 550307,
    "endMs": 554947
  },
  {
    "index": 130,
    "sceneId": "S20",
    "text": "“王婆卖瓜”难免有水分。",
    "startMs": 555347,
    "endMs": 557747
  },
  {
    "index": 131,
    "sceneId": "S20",
    "text": "所以必须进入投资前时期的第四关——7.3 项目评估与决策。",
    "startMs": 558307,
    "endMs": 564147
  },
  {
    "index": 132,
    "sceneId": "S21",
    "text": "请大家把 7.3 第一段话里的三个灵魂关键词（评估铁三角）刻在脑子里，",
    "startMs": 564815,
    "endMs": 572335
  },
  {
    "index": 133,
    "sceneId": "S21",
    "text": "过去 11 套卷考了 3 次填空：",
    "startMs": 572655,
    "endMs": 575695
  },
  {
    "index": 134,
    "sceneId": "S21",
    "text": "第一，在什么基础上做？",
    "startMs": 576095,
    "endMs": 578255
  },
  {
    "index": 135,
    "sceneId": "S21",
    "text": "在项目可行性研究的基础上（注意：",
    "startMs": 578735,
    "endMs": 582575
  },
  {
    "index": 136,
    "sceneId": "S21",
    "text": "不是在立项申请基础上！）；",
    "startMs": 582975,
    "endMs": 585295
  },
  {
    "index": 137,
    "sceneId": "S21",
    "text": "第二，由谁来做？",
    "startMs": 586655,
    "endMs": 588255
  },
  {
    "index": 138,
    "sceneId": "S21",
    "text": "由第三方（国家、银行或有关机构）来做（注意：",
    "startMs": 588815,
    "endMs": 594095
  },
  {
    "index": 139,
    "sceneId": "S21",
    "text": "绝不是建设单位自己，也不是承建单位！）；",
    "startMs": 594495,
    "endMs": 597535
  },
  {
    "index": 140,
    "sceneId": "S21",
    "text": "第三，审查什么目的？",
    "startMs": 598895,
    "endMs": 601135
  },
  {
    "index": 141,
    "sceneId": "S21",
    "text": "审查项目可行性研究的可靠性、",
    "startMs": 601695,
    "endMs": 604255
  },
  {
    "index": 142,
    "sceneId": "S21",
    "text": "真实性和客观性，",
    "startMs": 604575,
    "endMs": 606219
  },
  {
    "index": 143,
    "sceneId": "S21",
    "text": "为银行贷款决策或行政主管部门审批决策提供科学依据，",
    "startMs": 606219,
    "endMs": 611855
  },
  {
    "index": 144,
    "sceneId": "S21",
    "text": "最终成果叫《项目评估报告》。",
    "startMs": 612175,
    "endMs": 615135
  },
  {
    "index": 145,
    "sceneId": "S22",
    "text": "紧接着看 7.3.1 评估依据，",
    "startMs": 615781,
    "endMs": 618501
  },
  {
    "index": 146,
    "sceneId": "S22",
    "text": "这里藏着全章最经典的一个跨章大坑！",
    "startMs": 618821,
    "endMs": 622021
  },
  {
    "index": 147,
    "sceneId": "S22",
    "text": "项目评估的依据一共 5 项：",
    "startMs": 622501,
    "endMs": 625461
  },
  {
    "index": 148,
    "sceneId": "S22",
    "text": "第一、项目建议书及其批准文件；",
    "startMs": 625861,
    "endMs": 629221
  },
  {
    "index": 149,
    "sceneId": "S22",
    "text": "第二、项目可行性研究报告；",
    "startMs": 629621,
    "endMs": 632981
  },
  {
    "index": 150,
    "sceneId": "S22",
    "text": "第三、报送组织的申请报告及主管部门的初审意见；",
    "startMs": 633381,
    "endMs": 638181
  },
  {
    "index": 151,
    "sceneId": "S22",
    "text": "第四、项目关键建设条件和工程等的协议文件；",
    "startMs": 638501,
    "endMs": 642901
  },
  {
    "index": 152,
    "sceneId": "S22",
    "text": "第五、必需的其他文件和资料。",
    "startMs": 643301,
    "endMs": 646181
  },
  {
    "index": 153,
    "sceneId": "S23",
    "text": "请问：项目评估的依据里，",
    "startMs": 646817,
    "endMs": 649217
  },
  {
    "index": 154,
    "sceneId": "S23",
    "text": "有没有《项目章程》？",
    "startMs": 649697,
    "endMs": 650817
  },
  {
    "index": 155,
    "sceneId": "S23",
    "text": "绝对没有！",
    "startMs": 651377,
    "endMs": 652177
  },
  {
    "index": 156,
    "sceneId": "S23",
    "text": "为什么？你想想时间线：项目评估是在投资决策之前审可研报告，",
    "startMs": 652977,
    "endMs": 659377
  },
  {
    "index": 157,
    "sceneId": "S23",
    "text": "这时候还没决定给不给钱、",
    "startMs": 659617,
    "endMs": 662177
  },
  {
    "index": 158,
    "sceneId": "S23",
    "text": "立不立项呢，哪来的《项目章程》？",
    "startMs": 662497,
    "endMs": 665137
  },
  {
    "index": 159,
    "sceneId": "S23",
    "text": "《项目章程》是评估决策通过之后，",
    "startMs": 665617,
    "endMs": 668737
  },
  {
    "index": 160,
    "sceneId": "S23",
    "text": "到了第 8 章才签发的文件！",
    "startMs": 669057,
    "endMs": 671617
  },
  {
    "index": 161,
    "sceneId": "S23",
    "text": "命题人连续两年拿《项目章程》当干扰项，",
    "startMs": 672097,
    "endMs": 675697
  },
  {
    "index": 162,
    "sceneId": "S23",
    "text": "只要你脑子里有这条时间线，",
    "startMs": 676017,
    "endMs": 678017
  },
  {
    "index": 163,
    "sceneId": "S23",
    "text": "一秒钟就能看穿！",
    "startMs": 678417,
    "endMs": 680257
  },
  {
    "index": 164,
    "sceneId": "S24",
    "text": "不信？我们直接看屏幕上这四道真题，",
    "startMs": 680908,
    "endMs": 684428
  },
  {
    "index": 165,
    "sceneId": "S24",
    "text": "体验一下什么叫“降维打击”！",
    "startMs": 684748,
    "endMs": 688108
  },
  {
    "index": 166,
    "sceneId": "S25",
    "text": "先看上面两道考“铁三角”的：",
    "startMs": 688704,
    "endMs": 691344
  },
  {
    "index": 167,
    "sceneId": "S25",
    "text": "- 2024 年 5 月第 1 批次第 18 题：",
    "startMs": 691744,
    "endMs": 695184
  },
  {
    "index": 168,
    "sceneId": "S25",
    "text": "项目评估指在（  ）的基础上，",
    "startMs": 695584,
    "endMs": 699264
  },
  {
    "index": 169,
    "sceneId": "S25",
    "text": "由（  ）进行评价、分析和论证？",
    "startMs": 699664,
    "endMs": 702944
  },
  {
    "index": 170,
    "sceneId": "S27",
    "text": "第一空填项目可行性研究，",
    "startMs": 706622,
    "endMs": 709182
  },
  {
    "index": 171,
    "sceneId": "S27",
    "text": "第二空填第三方，直接选 D！",
    "startMs": 709582,
    "endMs": 713822
  },
  {
    "index": 172,
    "sceneId": "S27",
    "text": "（2023 年 11 月第 3 批次第 23 题单考第二空“由谁”，",
    "startMs": 713822,
    "endMs": 719982
  },
  {
    "index": 173,
    "sceneId": "S27",
    "text": "同样选 D 第三方）。",
    "startMs": 720302,
    "endMs": 721902
  },
  {
    "index": 174,
    "sceneId": "S28",
    "text": "2025 年 5 月第 1 批次第 33 题：",
    "startMs": 722516,
    "endMs": 726116
  },
  {
    "index": 175,
    "sceneId": "S28",
    "text": "项目评估与决策过程的目的是审查项目可行性研究的可靠性、",
    "startMs": 726436,
    "endMs": 731876
  },
  {
    "index": 176,
    "sceneId": "S30",
    "text": "跟着口诀念：可靠性、真实性、",
    "startMs": 736471,
    "endMs": 739911
  },
  {
    "index": 177,
    "sceneId": "S30",
    "text": "客观性！直接选 A（别被 B、",
    "startMs": 740311,
    "endMs": 744951
  },
  {
    "index": 178,
    "sceneId": "S30",
    "text": "C、D 里的“安全性、经济性”带跑偏）。",
    "startMs": 744951,
    "endMs": 748151
  },
  {
    "index": 179,
    "sceneId": "S31",
    "text": "再看下面两道考“评估依据”的：",
    "startMs": 748756,
    "endMs": 751396
  },
  {
    "index": 180,
    "sceneId": "S31",
    "text": "- 2023 年 5 月第 22 题：",
    "startMs": 751796,
    "endMs": 754836
  },
  {
    "index": 181,
    "sceneId": "S31",
    "text": "不可作为项目评估依据的是（  ）？",
    "startMs": 755236,
    "endMs": 757396
  },
  {
    "index": 182,
    "sceneId": "S31",
    "text": "A 建议书及批准文件、B 可行性研究报告、",
    "startMs": 757396,
    "endMs": 762916
  },
  {
    "index": 183,
    "sceneId": "S31",
    "text": "C 协议文件、D 项目章程。",
    "startMs": 763236,
    "endMs": 766676
  },
  {
    "index": 184,
    "sceneId": "S31",
    "text": "选哪个？",
    "startMs": 767156,
    "endMs": 767796
  },
  {
    "index": 185,
    "sceneId": "S33",
    "text": "直接选 D 项目章程！",
    "startMs": 771460,
    "endMs": 773380
  },
  {
    "index": 186,
    "sceneId": "S34",
    "text": "2023 年 11 月第 1 批次第 46 题：",
    "startMs": 773966,
    "endMs": 777166
  },
  {
    "index": 187,
    "sceneId": "S34",
    "text": "哪一项不属于项目评估的依据？",
    "startMs": 777486,
    "endMs": 780126
  },
  {
    "index": 188,
    "sceneId": "S34",
    "text": "A、B、C 原封不动，D 又是项目章程！",
    "startMs": 781246,
    "endMs": 785646
  },
  {
    "index": 189,
    "sceneId": "S36",
    "text": "还是选 D！",
    "startMs": 789271,
    "endMs": 790631
  },
  {
    "index": 190,
    "sceneId": "S36",
    "text": "而 23 年 11 月第 4 批次第 23 题则是把 B“项目可行性研究报告”挖了个空让你填。",
    "startMs": 791271,
    "endMs": 798791
  },
  {
    "index": 191,
    "sceneId": "S36",
    "text": "你看，这一串 6 道真题，全都在这几句话里！",
    "startMs": 799271,
    "endMs": 804551
  },
  {
    "index": 192,
    "sceneId": "S37",
    "text": "接下来我们把 7.3 剩下的三个小点收干净：",
    "startMs": 805292,
    "endMs": 809052
  },
  {
    "index": 193,
    "sceneId": "S37",
    "text": "评估的程序、评估的内容、",
    "startMs": 809452,
    "endMs": 812572
  },
  {
    "index": 194,
    "sceneId": "S37",
    "text": "评估报告大纲。",
    "startMs": 812892,
    "endMs": 814172
  },
  {
    "index": 195,
    "sceneId": "S37",
    "text": "第一，项目评估的 6 步程序（顺理成章，",
    "startMs": 814652,
    "endMs": 819132
  },
  {
    "index": 196,
    "sceneId": "S37",
    "text": "按顺序留个印象）：第一步成立评估小组，",
    "startMs": 819372,
    "endMs": 823772
  },
  {
    "index": 197,
    "sceneId": "S37",
    "text": "制订评估计划；第二步开展调查研究，",
    "startMs": 824172,
    "endMs": 828572
  },
  {
    "index": 198,
    "sceneId": "S37",
    "text": "站在公正立场核准已有数据可靠性、",
    "startMs": 828972,
    "endMs": 831772
  },
  {
    "index": 199,
    "sceneId": "S37",
    "text": "补充数据；第三步分析与评估；",
    "startMs": 832092,
    "endMs": 835212
  },
  {
    "index": 200,
    "sceneId": "S37",
    "text": "第四步编写、讨论、修改评估报告；",
    "startMs": 835692,
    "endMs": 839692
  },
  {
    "index": 201,
    "sceneId": "S37",
    "text": "第五步召开专家论证会；",
    "startMs": 840092,
    "endMs": 842972
  },
  {
    "index": 202,
    "sceneId": "S37",
    "text": "第六步评估报告定稿并发布。",
    "startMs": 843372,
    "endMs": 845372
  },
  {
    "index": 203,
    "sceneId": "S38",
    "text": "第二，项目评估的 15 项内容。",
    "startMs": 846070,
    "endMs": 848950
  },
  {
    "index": 204,
    "sceneId": "S38",
    "text": "不用死背 15 个标题，重点分清最新真题考到的 5 个易混评估项：",
    "startMs": 849510,
    "endMs": 855830
  },
  {
    "index": 205,
    "sceneId": "S38",
    "text": "- 项目建设的必要性评估：",
    "startMs": 856150,
    "endMs": 857910
  },
  {
    "index": 206,
    "sceneId": "S38",
    "text": "看是否符合国家产业政策、",
    "startMs": 858310,
    "endMs": 860230
  },
  {
    "index": 207,
    "sceneId": "S38",
    "text": "行业和地区规划、经济社会发展需要、",
    "startMs": 860710,
    "endMs": 865190
  },
  {
    "index": 208,
    "sceneId": "S38",
    "text": "市场需求和组织发展要求（审的是“要不要建”）；",
    "startMs": 865510,
    "endMs": 870150
  },
  {
    "index": 209,
    "sceneId": "S38",
    "text": "- 安装工程标准评估：看采用的标准与规范是否先进、",
    "startMs": 870550,
    "endMs": 875350
  },
  {
    "index": 210,
    "sceneId": "S38",
    "text": "合理，是否符合国家有关规定（注意：",
    "startMs": 875670,
    "endMs": 879670
  },
  {
    "index": 211,
    "sceneId": "S38",
    "text": "别把“标准与规范”混进上面的“建设必要性评估”里！）；",
    "startMs": 880070,
    "endMs": 883830
  },
  {
    "index": 212,
    "sceneId": "S38",
    "text": "- 项目的财务效益评估：看基本数据是否可靠、",
    "startMs": 885270,
    "endMs": 889830
  },
  {
    "index": 213,
    "sceneId": "S38",
    "text": "财务指标计算及参数是否正确、",
    "startMs": 890150,
    "endMs": 892550
  },
  {
    "index": 214,
    "sceneId": "S38",
    "text": "推荐方案是否是“最佳方案”；",
    "startMs": 892950,
    "endMs": 895350
  },
  {
    "index": 215,
    "sceneId": "S38",
    "text": "- 国民经济效益评估：在财务经济效益评估基础上，",
    "startMs": 895750,
    "endMs": 900390
  },
  {
    "index": 216,
    "sceneId": "S38",
    "text": "重点核查费用和效益的范围及其数值的调整是否正确；",
    "startMs": 900710,
    "endMs": 905350
  },
  {
    "index": 217,
    "sceneId": "S38",
    "text": "- 项目风险评估：包括盈亏平衡分析、",
    "startMs": 905750,
    "endMs": 909190
  },
  {
    "index": 218,
    "sceneId": "S38",
    "text": "敏感性分析、主要风险因素及其敏感度和概率分析、",
    "startMs": 909430,
    "endMs": 914230
  },
  {
    "index": 219,
    "sceneId": "S38",
    "text": "风险预防措施及处置方案（注意：",
    "startMs": 914550,
    "endMs": 918870
  },
  {
    "index": 220,
    "sceneId": "S38",
    "text": "盈亏平衡分析和敏感性分析在项目评估里归在“项目风险评估”项下！）",
    "startMs": 919270,
    "endMs": 925510
  },
  {
    "index": 221,
    "sceneId": "S39",
    "text": "第三，项目评估报告内容大纲，",
    "startMs": 926822,
    "endMs": 929702
  },
  {
    "index": 222,
    "sceneId": "S39",
    "text": "只包含三大块：第一、项目概况（含是否批准或可否贷款的结论性意见）、",
    "startMs": 930022,
    "endMs": 938022
  },
  {
    "index": 223,
    "sceneId": "S39",
    "text": "第二、详细评估意见、第三、",
    "startMs": 938342,
    "endMs": 941462
  },
  {
    "index": 224,
    "sceneId": "S39",
    "text": "总结和建议（重大问题、潜在风险、",
    "startMs": 941782,
    "endMs": 946022
  },
  {
    "index": 225,
    "sceneId": "S40",
    "text": "我们马上看 2026 年 5 月第 1 批次刚考的第 27 题，",
    "startMs": 947671,
    "endMs": 952151
  },
  {
    "index": 226,
    "sceneId": "S40",
    "text": "问关于项目评估内容的相关描述，",
    "startMs": 952471,
    "endMs": 954871
  },
  {
    "index": 227,
    "sceneId": "S40",
    "text": "不正确的是哪一项？",
    "startMs": 955271,
    "endMs": 957511
  },
  {
    "index": 228,
    "sceneId": "S41",
    "text": "你看 A 财务效益评估（最佳方案）、",
    "startMs": 958233,
    "endMs": 961273
  },
  {
    "index": 229,
    "sceneId": "S41",
    "text": "B 项目风险评估（含盈亏平衡分析、",
    "startMs": 961513,
    "endMs": 964953
  },
  {
    "index": 230,
    "sceneId": "S41",
    "text": "敏感性分析）、C 国民经济效益评估（核查费用和效益范围及数值调整），",
    "startMs": 965193,
    "endMs": 972793
  },
  {
    "index": 231,
    "sceneId": "S41",
    "text": "全都是刚才表格里的原话！",
    "startMs": 973113,
    "endMs": 975113
  },
  {
    "index": 232,
    "sceneId": "S43",
    "text": "问题出在哪儿？",
    "startMs": 978706,
    "endMs": 980147
  },
  {
    "index": 233,
    "sceneId": "S43",
    "text": "看 D 选项：“项目建设必要性评估的内容包括是否符合国家产业政策，",
    "startMs": 980626,
    "endMs": 987666
  },
  {
    "index": 234,
    "sceneId": "S43",
    "text": "标准与规范是否先进、合理，",
    "startMs": 987986,
    "endMs": 991346
  },
  {
    "index": 235,
    "sceneId": "S43",
    "text": "是否符合国家有关规定”。",
    "startMs": 991746,
    "endMs": 994546
  },
  {
    "index": 236,
    "sceneId": "S43",
    "text": "抓到了吧！",
    "startMs": 995026,
    "endMs": 995746
  },
  {
    "index": 237,
    "sceneId": "S43",
    "text": "前半句“符合国家产业政策”确实是建设必要性评估，",
    "startMs": 996226,
    "endMs": 1001826
  },
  {
    "index": 238,
    "sceneId": "S43",
    "text": "但后半句“标准与规范是否先进、",
    "startMs": 1002146,
    "endMs": 1006066
  },
  {
    "index": 239,
    "sceneId": "S43",
    "text": "合理，是否符合国家有关规定”属于安装工程标准评估！",
    "startMs": 1006386,
    "endMs": 1012946
  },
  {
    "index": 240,
    "sceneId": "S43",
    "text": "命题人把两个评估项嫁接在了一起，",
    "startMs": 1013426,
    "endMs": 1016626
  },
  {
    "index": 241,
    "sceneId": "S43",
    "text": "所以不正确的选 D。",
    "startMs": 1016946,
    "endMs": 1019106
  },
  {
    "index": 242,
    "sceneId": "S44a",
    "text": "到这里，第 7 章《项目立项管理》我们就全部学完了！",
    "startMs": 1019776,
    "endMs": 1024416
  },
  {
    "index": 243,
    "sceneId": "S44a",
    "text": "最后用一分钟，把整章浓缩成一张“立项闯关与交接总图”：",
    "startMs": 1024896,
    "endMs": 1030736
  },
  {
    "index": 244,
    "sceneId": "S44b",
    "text": "第一关（7.1 提申请）：",
    "startMs": 1031383,
    "endMs": 1033612
  },
  {
    "index": 245,
    "sceneId": "S44b",
    "text": "建设单位向上级主管部门交《项目建议书（立项申请）》，",
    "startMs": 1033612,
    "endMs": 1039463
  },
  {
    "index": 246,
    "sceneId": "S44b",
    "text": "它只是框架性总体设想，",
    "startMs": 1039783,
    "endMs": 1041463
  },
  {
    "index": 247,
    "sceneId": "S44b",
    "text": "记住口诀“一必要、两市场、",
    "startMs": 1041783,
    "endMs": 1045303
  },
  {
    "index": 248,
    "sceneId": "S44b",
    "text": "一条件”。",
    "startMs": 1045543,
    "endMs": 1047143
  },
  {
    "index": 249,
    "sceneId": "S44c",
    "text": "第二、三关（7.2 做可研）：先做初步可研（精度正负 20%，",
    "startMs": 1047757,
    "endMs": 1054637
  },
  {
    "index": 250,
    "sceneId": "S44c",
    "text": "评估前途与辅助研究），再做不可缺少的详细可研（精度正负 10%，",
    "startMs": 1055517,
    "endMs": 1062557
  },
  {
    "index": 251,
    "sceneId": "S44c",
    "text": "用“有无比较法”算增量净效益）。",
    "startMs": 1062557,
    "endMs": 1065437
  },
  {
    "index": 252,
    "sceneId": "S44d",
    "text": "算账时戴好五顶帽子，尤其分清“人力资源有效性、",
    "startMs": 1066046,
    "endMs": 1071806
  },
  {
    "index": 253,
    "sceneId": "S44d",
    "text": "技术能力可能性（属技术可研）”和“人员提升收益、",
    "startMs": 1072126,
    "endMs": 1076686
  },
  {
    "index": 254,
    "sceneId": "S44d",
    "text": "技术创新效益（属社会效益-组织内部）”，",
    "startMs": 1077006,
    "endMs": 1081006
  },
  {
    "index": 255,
    "sceneId": "S44d",
    "text": "分清“设备购置费（一次性）对比软硬件租金（非一次性）”。",
    "startMs": 1081406,
    "endMs": 1086926
  },
  {
    "index": 256,
    "sceneId": "S44e",
    "text": "第四关（7.3 拍板评估）：在可研基础上，",
    "startMs": 1087542,
    "endMs": 1093622
  },
  {
    "index": 257,
    "sceneId": "S44e",
    "text": "请第三方审查可研的可靠性、",
    "startMs": 1093942,
    "endMs": 1097142
  },
  {
    "index": 258,
    "sceneId": "S44e",
    "text": "真实性、客观性，依据里绝没有《项目章程》！",
    "startMs": 1097462,
    "endMs": 1103062
  },
  {
    "index": 259,
    "sceneId": "S45",
    "text": "当第四关评估通过、上级主管部门拍板决定投资立项之后，",
    "startMs": 1103674,
    "endMs": 1108794
  },
  {
    "index": 260,
    "sceneId": "S45",
    "text": "会发生什么？",
    "startMs": 1109114,
    "endMs": 1109914
  },
  {
    "index": 261,
    "sceneId": "S45",
    "text": "这几份立项阶段的结晶——项目建议书、",
    "startMs": 1110474,
    "endMs": 1114394
  },
  {
    "index": 262,
    "sceneId": "S45",
    "text": "可行性研究报告、项目评估报告，",
    "startMs": 1114714,
    "endMs": 1117914
  },
  {
    "index": 263,
    "sceneId": "S45",
    "text": "就会化作项目建设的依据文件。",
    "startMs": 1118234,
    "endMs": 1120794
  },
  {
    "index": 264,
    "sceneId": "S46",
    "text": "随着项目发起人签发《项目章程》，",
    "startMs": 1121463,
    "endMs": 1124183
  },
  {
    "index": 265,
    "sceneId": "S46",
    "text": "正式任命项目经理，项目才真正进入‘如何建设和管理’的阶段。",
    "startMs": 1124503,
    "endMs": 1130103
  },
  {
    "index": 266,
    "sceneId": "S46",
    "text": "我们下一章见！",
    "startMs": 1130583,
    "endMs": 1131463
  }
]
